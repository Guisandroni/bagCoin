# bagcoin_api Environment Variables

# === Project ===
PROJECT_NAME=bagcoin_api
DEBUG=true
ENVIRONMENT=local
TIMEZONE=UTC  # IANA timezone: UTC, Europe/Warsaw, America/New_York
MODELS_CACHE_DIR=./models_cache

# === Logfire ===
# Get your token at https://logfire.pydantic.dev
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=bagcoin_api
LOGFIRE_ENVIRONMENT=development

# === PostgreSQL ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bagcoin_api

# === JWT Auth ===
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# === API Key Auth ===
API_KEY=change-me-in-production
API_KEY_HEADER=X-API-Key

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_DB=0


# === AI Agent (langgraph, openai) ===
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_TEMPERATURE=0.7

# === LangSmith Observability ===
# Get your API key at https://smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=bagcoin_api
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# === CORS ===
# JSON list of allowed origins (default: localhost:3000, localhost:8080)
# Note: "*" is blocked in production - specify explicit origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# === Docker Production (Traefik) ===
# Domain for production deployment
DOMAIN=example.com

# Let's Encrypt email for SSL certificates
ACME_EMAIL=admin@example.com

# Traefik dashboard auth (generate with: htpasswd -nb admin password)
# TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$...
# Redis password for production
 # REDIS_PASSWORD=
# Evolution API: v2.3.7 is vulnerable (CVE-2026-48063), for isolated simulations only.
# For Compose, set these values in the project-root .env used for interpolation.
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_INSTANCE_NAME=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
# Dedicated PostgreSQL role/database; values must contain only letters, digits, _ or -.
EVOLUTION_DB_USER=
EVOLUTION_DB_PASSWORD=
EVOLUTION_DB_NAME=

# === Bot deep links (pairing: wa.me) ===
# Required for web UI "Conectar" to open WhatsApp with the link token prefilled.
# Digits only for WhatsApp, e.g. +55 27 92834-1723 → 5527928341723
BOT_WHATSAPP_NUMBER=5527928341723

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# === Email Delivery ===
# Provider options: smtp | resend_api
# Local Docker uses this file via docker-compose.yml. For Resend tests, keep
# EMAIL_PROVIDER=resend_api and provide a real API key plus a verified sender.
EMAIL_PROVIDER=resend_api
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_API_BASE_URL=https://api.resend.com

# Optional external SMTP provider: set EMAIL_PROVIDER=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@bagcoin.local
SMTP_USE_TLS=false
